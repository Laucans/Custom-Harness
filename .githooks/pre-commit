#!/usr/bin/env bash
# cargo fmt --check, scoped to the .rs files actually staged for this commit.
# `cargo fmt` has no "only these files" flag, so this calls `rustfmt` (the
# same formatter, same rustfmt.toml) directly on the staged list instead.
set -euo pipefail

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs')

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

if ! rustfmt --check --edition 2024 "${files[@]}"; then
  echo >&2
  echo "cargo fmt: staged .rs files are not formatted — run \`cargo fmt\` and re-stage." >&2
  exit 1
fi
