# Template for .env.local — committed on purpose, never holds real values.
# Copy it (`cp .env.example .env.local`) and fill in. Every new variable the
# code reads gets a line here.
#
# Loaded by direnv's .envrc (`dotenv_if_exists .env.local`), which is scoped to
# this directory: it only applies to a shell actually cd'd into pipelinev2/,
# not to the binary invoked by path from elsewhere. Everything below has a
# built-in default in crates/launcher/src/cli.rs — a variable only needs to be
# set here to override that default. `harness --help` shows the same list.
#
# The two on/off switches (ALLOW_DIRTY, KEEP_WORKSPACE) accept 1/true/yes,
# 0/false/no, or empty (= off) — anything else is refused rather than
# silently read as off.

# Which stages run, space-separated. Empty (the default) means all of them.
STAGES=

# Force a model/effort for every stage of the run. Empty keeps each stage's own.
MODEL=
EFFORT=

# How many rounds (task cycles) a single run attempts at most.
MAX_ROUNDS=3

# The branch the loop works on and merges into. Also what `harness init-repo`
# creates on the target repo when it doesn't exist yet.
INTEGRATION_BRANCH=main_agent

# Passed to `claude -p`. The target repo's PreToolUse hooks still apply.
PERMISSION_MODE=bypassPermissions

# 1 to skip the clean-working-tree gate. Only meaningful with --no-workspace —
# a mounted workspace is a clone, and is clean by construction.
ALLOW_DIRTY=

# --- workspace mounting -----------------------------------------------------

# The repository `harness init-repo <url>` initializes, and the loop mounts.
# Written by `init-repo` itself; override with --workspace-url for one run.
# Empty: this checkout's own `origin`.
TARGET_REPO_URL=

# permanent (default, never deletes) or tmp (disposable).
WORKSPACE_STRATEGY=

# The URL to clone. Empty: TARGET_REPO_URL, else this checkout's own `origin`.
WORKSPACE_URL=

# Where mounted workspaces live. Empty: <repo>/.llocal/agentic_workspaces.
AGENTIC_WORKSPACES_DIR=

# 1 to keep a disposable (tmp) workspace that the run would otherwise delete.
KEEP_WORKSPACE=
